+/* 長い動画（作業用BGM）。埋め込みの一覧を出し、renjill-media/bgm.json（投稿の自動化 renjill-auto が、出すたびに書く）があればそちらを優先する。
+   形：[{ date:"2026-11-14", youtube_id, minutes:60, thumb:"bgm_2026-11-13_thumb.jpg", title:{ja,en,zh,ko} }]。新しい順に4本まで。0本なら枠ごと隠す */
+const LONGS = [
+  { date: "2026-11-14", yt: "gb0SAEwlNtw", minutes: 60, thumb: "bgm_2026-11-13_thumb.jpg", title: ["雨の夜の残業", "Rainy Night Overtime", "下雨夜的加班", "비 오는 밤의 야근"] },
+];
+function renderLongs() {
+  const box = $("#longplay"), ul = $("#lpList"); if (!box || !ul) return;
+  const L = li(), list = LONGS.filter((x) => x.yt && x.title && x.title[0]).slice(0, 4);
+  box.hidden = !list.length; ul.classList.toggle("one", list.length === 1);
+  const len = (m) => { m = Math.round(+m || 0); return m >= 60 ? `${Math.floor(m / 60)}:${String(m % 60).padStart(2, "0")}:00` : `${m}:00`; };
+  ul.innerHTML = list.map((x) => { const name = esc(x.title[L] || x.title[1] || x.title[0]);
+    return `<li><a class="lp-card" href="https://www.youtube.com/watch?v=${encodeURIComponent(x.yt)}" target="_blank" rel="noopener"><span class="lp-thumb"><img src="${MEDIA}${encodeURIComponent(x.thumb || "")}" alt="${name}" loading="lazy" decoding="async" width="1280" height="720" onerror="this.onerror=null;this.src='https://i.ytimg.com/vi/${encodeURIComponent(x.yt)}/mqdefault.jpg'">${x.minutes ? `<span class="lp-len">${len(x.minutes)}</span>` : ""}</span><span class="lp-name">${name}</span><span class="lp-date">${esc((x.date || "").replace(/-/g, "."))}</span></a></li>`; }).join("");
+}
+renderLongs(); langHooks.push(renderLongs);
+(async () => {
+  try {
+    const ctrl = new AbortController(); setTimeout(() => ctrl.abort(), 5000);
+    const r = await fetch("https://raw.githubusercontent.com/ibato-byte/renjill-media/main/bgm.json", { signal: ctrl.signal, cache: "no-cache" });
+    if (!r.ok) return;
+    const data = await r.json(); if (!Array.isArray(data)) return;
+    const mapped = data.map((x) => { const v = x.title || {}; const ja = typeof v === "string" ? v : v.ja || v.en || "", en = (typeof v === "object" && v.en) || ja;
+      return { date: String(x.date || "").slice(0, 10), yt: x.youtube_id || x.yt || "", minutes: x.minutes, thumb: x.thumb, title: [ja, en, (typeof v === "object" && (v.zh || v["zh-Hant"])) || en, (typeof v === "object" && v.ko) || en] }; })
+      .filter((x) => /^[\w-]{6,}$/.test(x.yt) && x.title[0] && (!x.thumb || /^[\w.-]+$/.test(x.thumb))).sort((a, b) => b.date.localeCompare(a.date));
+    if (!mapped.length || mapped.map((x) => x.yt).join() === LONGS.map((x) => x.yt).join()) return;
+    LONGS.length = 0; LONGS.push(...mapped); renderLongs();
+  } catch (e) { /* offline or no file: keep the embedded list */ }
+})();
 /* optional: renjill-media/episodes.json (written by the posting pipeline) overrides the embedded list,
    so new episodes appear without editing this file. Either schema works:
    { ep, date, title:{ja,en,zh,ko}, caption:{ja,en,zh,ko}, cover, video, youtube_id }  or the older
